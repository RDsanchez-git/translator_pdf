    "depth": 0,
    "payload": {
      "content": "Because Python looks for a match within a given try by inspecting the except clauses\nfrom top to bottom, the parenthesized version has the same effect as listing each ex-\nception in its own except clause, but you have to code the statement body only once.\nHere’s an example of multiple except clauses at work, which demonstrates just how\nspecific your handlers can be:"
    },
    "control_plane": {},
    "parent_node_id": null,
    "segment_index": 0,
    "segment_count": 1
  },
