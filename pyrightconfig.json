{
  "include": [
    "core",
    "apps",
    "infra",
    "runtime"
  ],
  "exclude": [
    "tests",
    "tools",
    "graveyard",
    "experiments",
    "venv",
    ".venv",
    "reports",
    "build",
    "dist",
    "**/node_modules",
    "**/__pycache__",
    "**/.*"
  ],
  "pythonVersion": "3.11",
  "pythonPlatform": "Linux",
  "typeCheckingMode": "standard",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false
}
